{
  "expo": {
    "name": "Hop London",
    "slug": "ldn-map",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "hoplondon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0057A8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoplondon.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hop London uses your location to show nearby stops and live arrivals."
      }
    },
    "android": {
      "package": "com.hoplondon.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0057A8"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hop London uses your location to show nearby stops and live arrivals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
